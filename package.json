{
  "name": "bcu-rust-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build crates/bcu-api --target web --out-dir ../../pkg",
    "build": "tsc --noEmit && bun run build:wasm && vite build",
    "preview": "vite preview",
    "test:ts": "bun test tests/",
    "test:rust": "cargo test",
    "test": "bun run test:ts && bun run test:rust",
    "test:watch": "bun test --watch tests/",
    "lint:rust": "cargo fmt -- --check && cargo clippy -- -D warnings",
    "lint:pedantic": "cargo clippy -- -D warnings -D clippy::pedantic",
    "lint:ts": "tsc --noEmit",
    "lint": "bun run lint:ts && bun run lint:rust",
    "fmt:rust": "cargo fmt",
    "fmt:ts": "echo 'No TS formatter configured yet'",
    "format": "bun run fmt:rust && bun run fmt:ts",
    "check:rust": "cargo check",
    "parity:check": "cargo run -p parity-tester",
    "ready": "bun run format && bun run lint && bun run build && bun run test",
    "clean": "rm -rf dist pkg target node_modules/.vite"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.0",
    "@types/bun": "^1.2.0",
    "happy-dom": "^20.10.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}
