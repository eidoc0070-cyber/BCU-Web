{
  "name": "bcu-rust-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build crates/bcu-api --target web --out-dir ../../pkg",
    "build": "bun run build:wasm && vite build",
    "preview": "vite preview",
    "test": "bun test tests/ && cargo test",
    "ready": "tsc --noEmit && bun run build && bun run test"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.0",
    "@types/bun": "^1.2.0",
    "happy-dom": "^20.10.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}
